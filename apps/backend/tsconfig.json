{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/be/*": ["./src/*"],
      "@/api/*": ["../../packages/api/src/*"],
      "@/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": ["src", "src/**/*.json"],
  "exclude": ["dist", "node_modules"]
}
