        "responses": {
          "200": {
            "description": "운영자 역할 삭제 성공"
          },
          "401": {
            "description": "인증 실패"
          },
          "403": {
            "description": "권한 없음"
          },
          "404": {
            "description": "역할 할당을 찾을 수 없음"
          }
        }
      }
    },
