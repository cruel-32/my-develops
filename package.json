    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "turbo run start --filter=web --filter=backend",
    "docker:build": "./scripts/docker-build.sh",
